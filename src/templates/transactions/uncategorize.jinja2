<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Capital Focus</title>
    <link rel="icon" href="../static/imgs/icon-light-32x32.png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="../static/imgs/icon-dark-32x32.png" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="../static/imgs/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="../static/imgs/apple-icon.png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../../static/styles/styles.css">
    <link rel="stylesheet" href="../../static/styles/transactions/uncategorize.css">
</head>

<body>
    <!-- Header (Heuristic 4: Consistency and standards) -->
    <nav class="navbar navbar-light bg-white border-bottom sticky-top">
        <div class="container-fluid">
            <button class="btn btn-link text-dark p-0" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#sideMenu" aria-label="Open menu">
                <i class="bi bi-list fs-4"></i>
            </button>
            <span class="navbar-brand mb-0 h5 fw-semibold">Capital Focus</span>
            <button class="btn btn-link text-dark p-0 position-relative" aria-label="Notifications">
                <i class="bi bi-bell fs-5"></i>
            </button>
        </div>
    </nav>

    <!-- Side Menu Offcanvas (Heuristic 3: User control and freedom) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sideMenu">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link active text-primary fw-bold" href="UncategorizeItems.html">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="Budgets.html">Budgets</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="BudgetDescription.html">Current Budget</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="#">Reports</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="#">Settings</a></li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container-fluid py-4 bg-light min-vh-100">
        <!-- Summary card (Heuristic 1: Visibility of system status) -->
        <div class="card summary-card shadow-sm mb-4" style="max-width: 400px;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="text-muted fw-bold mb-0">PENDING TRANSACTIONS</h6>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="summary-item bg-warning-subtle">
                            <span class="summary-label">To Categorize</span>
                            <span class="summary-value text-warning">12</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Bar (Heuristic 7: Flexibility and efficiency of use) -->
        <div class="mb-4">
            <div class="input-group shadow-sm rounded-3 overflow-hidden" style="max-width: 500px;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-0 py-2" placeholder="Search transactions..." aria-label="Search">
            </div>
        </div>

        <!-- Transaction Cards (Heuristic 8: Aesthetic and minimalist design) -->
        <div class="row g-3" id="transactionList">
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading transactions...</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Transaction Categorization Modal -->
    <div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="transactionModalLabel">Categorize Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="transactionForm" class="form-scroll">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Commerce</label>
                            <input type="text" class="form-control bg-light border-0" id="modalCommerce" tabindex="-1">
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label text-muted small fw-bold">Date</label>
                                <input type="text" class="form-control bg-light border-0" id="modalDate"  tabindex="-1">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small fw-bold">Amount</label>
                                <input type="text" class="form-control bg-light border-0" id="modalAmount"  tabindex="-1">
                            </div>
                        </div>
                        <hr class="my-4 text-muted opacity-25">
                        <div class="mb-3">
                            <label for="budgetSelect" class="form-label fw-bold">Budget</label>
                            <select class="form-select border-0 bg-light" id="budgetSelect" required>
                                <option value="" selected disabled>Select a budget...</option>
                                <option value="Budget1">January 2026</option>
                                <option value="Budget2">February 2026</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="categorySelect" class="form-label fw-bold">Category</label>
                            <select class="form-select border-0 bg-light" id="categorySelect" required>
                                <option value="" selected disabled>Select a category...</option>
                                <option value="Payments">Payments</option>
                                <option value="Food">Food</option>
                                <option value="Luxuries">Luxuries</option>
                            </select>
                        </div>
                        <div id="additionalDetails" class="d-none">
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">City and country</label>
                                <input id="modalLocation" type="text" class="form-control bg-light border-0" readonly tabindex="-1">
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Card</label>
                                <input id="modalCard" type="text" class="form-control bg-light border-0" readonly tabindex="-1">
                            </div>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-primary fw-bold" id="toggleDetails">Show More Details</button>
                    </form>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-between">
                    <button type="button" class="btn btn-light rounded-circle shadow-sm" id="prevButton" title="Previous"><i class="bi bi-chevron-left"></i></button>
                    <div>
                        <button type="button" class="btn btn-outline-danger me-2 rounded-pill px-3 border-0" id="deleteButton">Delete</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" id="saveButton">Save Changes</button>
                    </div>
                    <button type="button" class="btn btn-light rounded-circle shadow-sm" id="nextButton" title="Next"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="../../static/scripts/transactions/uncategorize.js"></script>
</body>

</html>