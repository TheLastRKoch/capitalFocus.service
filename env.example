DJANGO_SECRET_KEY=

DB_CONNECTION=

# JSON list of hostnames, without scheme (e.g. ["example.com", "127.0.0.1"]).
ALLOWED_HOSTS=

# Optional JSON list of trusted CSRF origins (e.g.
# ["https://example.com"]). When omitted, every ALLOWED_HOSTS entry is trusted
# on both http and https.
CSRF_TRUSTED_ORIGINS=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Optional. Owner assigned to new budgets until multi-user auth exists.
# Defaults to "rkoch" when unset or empty.
DEFAULT_BUDGET_OWNER_USERNAME=rkoch
